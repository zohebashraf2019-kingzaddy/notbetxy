# Public site URL (used for SEO, canonical links and Open Graph). Set to the custom domain once connected.
NEXT_PUBLIC_SITE_URL=https://notbetxy.vercel.app

# Public business email shown on the site (leave blank to hide it).
NEXT_PUBLIC_CONTACT_EMAIL=

# Inquiry form delivery via Resend (https://resend.com) — required for the form to send.
RESEND_API_KEY=
# Where inquiries are delivered (Betxy's business inbox). Comma-separate for multiple.
INQUIRY_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "NOTBETXY Inquiries <inquiries@notbetxy.com>"
INQUIRY_FROM_EMAIL=
